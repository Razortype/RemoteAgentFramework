*.key
*.pem
*.p12
*.pfx
secrets.yaml
secrets.json
.env.local
.env.production

# Simulation outputs (safe to commit as examples, but exclude large files)
outbox/*.json
lab_test_files/
simulation_data/
logs/
*.log

